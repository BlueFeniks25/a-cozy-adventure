    {
      "id": "host-voicechat",
      "detail": "config/voicechat/voicechat-server.properties is absent. Obtain the assigned UDP port from Host Unlimited, generate the file on first start, and configure it manually. No production port is invented."
    },
    {
      "id": "claims",
      "detail": "Open Parties and Claims stays installed, but its server config is absent from the index. Do not copy config-review automatically; its prometheus and argonauts_guilds adapters are absent from this pack. Review claim permissions and defaults on first start."
    },
    {
      "id": "polymer-resources",
      "detail": "Polymer auto-host/resource-pack config is not included. Review config-review manually; world/resources.zip is absent. Colorful Trims RP remains in the clientpack; this ZIP distributes no client resource packs."
    },
    {
      "id": "npc-security",
      "detail": "Easy NPC security.cfg and remote_texture.cfg exist only in config-review. Review permission and remote URL policies manually before allowing NPC editing; no excluded file is promoted."
    },
    {
      "id": "server-toml-location",
